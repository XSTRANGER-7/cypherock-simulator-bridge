diff --git a/simulator/transport/sim_socket.c b/simulator/transport/sim_socket.c
new file mode 100644
index 00000000..619909f7
--- /dev/null
+++ b/simulator/transport/sim_socket.c
@@ -0,0 +1,275 @@
+/**
+ * @file    sim_socket.c
+ * @brief   Non-blocking TCP frame server for the X1 firmware simulator.
+ *
+ * Carries fixed-size USB-style frames between the Cypherock SDK
+ * (@cypherock/sdk-hw-simulator) and the simulator. Single-threaded and
+ * non-blocking: call sim_socket_poll() often from the simulator's main
+ * thread. Binds to 127.0.0.1 only.
+ *
+ * Builds with POSIX sockets (Linux, macOS) and Winsock (Windows / MinGW).
+ */
+#include "sim_socket.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+
+typedef SOCKET sim_fd_t;
+#define SIM_INVALID_FD INVALID_SOCKET
+#define SIM_SEND_FLAGS 0
+#define sim_close_fd closesocket
+
+static int sim_would_block(void) {
+  return WSAGetLastError() == WSAEWOULDBLOCK;
+}
+
+static void sim_sleep_short(void) {
+  Sleep(1);
+}
+
+static int set_non_blocking(sim_fd_t fd) {
+  u_long mode = 1;
+  return ioctlsocket(fd, FIONBIO, &mode) == 0 ? 0 : -1;
+}
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+typedef int sim_fd_t;
+#define SIM_INVALID_FD (-1)
+#ifdef MSG_NOSIGNAL
+#define SIM_SEND_FLAGS MSG_NOSIGNAL
+#else
+#define SIM_SEND_FLAGS 0 /* macOS: SO_NOSIGPIPE is set on the client socket */
+#endif
+#define sim_close_fd close
+
+static int sim_would_block(void) {
+  return errno == EAGAIN || errno == EWOULDBLOCK;
+}
+
+static void sim_sleep_short(void) {
+  usleep(100);
+}
+
+static int set_non_blocking(sim_fd_t fd) {
+  int flags = fcntl(fd, F_GETFL, 0);
+  if (flags < 0)
+    return -1;
+  return fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+#endif
+
+#define SIM_LOG(...)                                                           \
+  do {                                                                         \
+    if (sim_socket_verbose) {                                                  \
+      fprintf(stderr, "[sim_socket] ");                                        \
+      fprintf(stderr, __VA_ARGS__);                                            \
+      fprintf(stderr, "\n");                                                   \
+    }                                                                          \
+  } while (0)
+
+/* Give up on a client that stops reading for about 2 seconds. */
+#define SIM_SOCKET_MAX_WRITE_WAITS 20000
+
+static sim_fd_t listen_fd = SIM_INVALID_FD;
+static sim_fd_t client_fd = SIM_INVALID_FD;
+static uint16_t bound_port = 0;
+static sim_socket_rx_cb_t on_frame = NULL;
+static uint8_t rx_buf[SIM_SOCKET_FRAME_SIZE];
+static size_t rx_len = 0;
+static int sim_socket_verbose = 0;
+#ifdef _WIN32
+static int wsa_started = 0;
+#endif
+
+static void close_client(void) {
+  if (client_fd != SIM_INVALID_FD) {
+    sim_close_fd(client_fd);
+    client_fd = SIM_INVALID_FD;
+    rx_len = 0;
+    SIM_LOG("client disconnected");
+  }
+}
+
+static void close_listener(void) {
+  if (listen_fd != SIM_INVALID_FD) {
+    sim_close_fd(listen_fd);
+    listen_fd = SIM_INVALID_FD;
+  }
+}
+
+sim_socket_status_t sim_socket_init(uint16_t port, sim_socket_rx_cb_t rx_cb) {
+  const char *verbose = getenv("CYPHEROCK_SIM_VERBOSE");
+  sim_socket_verbose = (verbose && verbose[0] == '1');
+
+  if (port == 0) {
+    const char *env_port = getenv("CYPHEROCK_SIM_PORT");
+    port = env_port ? (uint16_t)atoi(env_port) : SIM_SOCKET_DEFAULT_PORT;
+  }
+
+#ifdef _WIN32
+  if (!wsa_started) {
+    WSADATA wsa;
+    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0)
+      return SIM_SOCKET_ERR_SOCKET;
+    wsa_started = 1;
+  }
+#endif
+
+  on_frame = rx_cb;
+  listen_fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  if (listen_fd == SIM_INVALID_FD)
+    return SIM_SOCKET_ERR_SOCKET;
+
+#ifndef _WIN32
+  /* On Windows SO_REUSEADDR lets another process steal the port; skip it. */
+  int yes = 1;
+  setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+#endif
+
+  struct sockaddr_in addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sin_family = AF_INET;
+  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK); /* never beyond localhost */
+  addr.sin_port = htons(port);
+
+  if (bind(listen_fd, (struct sockaddr *)&addr, sizeof(addr)) != 0) {
+    close_listener();
+    return SIM_SOCKET_ERR_BIND;
+  }
+  if (listen(listen_fd, 1) != 0 || set_non_blocking(listen_fd) != 0) {
+    close_listener();
+    return SIM_SOCKET_ERR_LISTEN;
+  }
+
+  socklen_t addr_len = sizeof(addr);
+  getsockname(listen_fd, (struct sockaddr *)&addr, &addr_len);
+  bound_port = ntohs(addr.sin_port);
+
+  /* Always printed: scripts/start-simulator.sh waits for this line. */
+  fprintf(stderr, "[sim_socket] listening on 127.0.0.1:%u\n", bound_port);
+  fflush(stderr);
+  return SIM_SOCKET_OK;
+}
+
+static void accept_client(void) {
+  sim_fd_t fd = accept(listen_fd, NULL, NULL);
+  if (fd == SIM_INVALID_FD)
+    return; /* would block: nobody waiting */
+
+  if (client_fd != SIM_INVALID_FD) {
+    /* One client at a time, like one USB host. Newest wins. */
+    close_client();
+  }
+  set_non_blocking(fd);
+  int yes = 1;
+  setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, (const char *)&yes, sizeof(yes));
+#ifdef SO_NOSIGPIPE
+  setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes));
+#endif
+  client_fd = fd;
+  rx_len = 0;
+  SIM_LOG("client connected");
+}
+
+static void read_client(void) {
+  uint8_t chunk[512];
+  for (;;) {
+    int n = (int)recv(client_fd, (char *)chunk, (int)sizeof(chunk), 0);
+    if (n == 0) {
+      close_client();
+      return;
+    }
+    if (n < 0) {
+      if (!sim_would_block())
+        close_client();
+      return;
+    }
+    for (int i = 0; i < n; i++) {
+      rx_buf[rx_len++] = chunk[i];
+      if (rx_len == SIM_SOCKET_FRAME_SIZE) {
+        rx_len = 0;
+        if (on_frame)
+          on_frame(rx_buf, SIM_SOCKET_FRAME_SIZE);
+        if (client_fd == SIM_INVALID_FD)
+          return; /* the callback may have closed us */
+      }
+    }
+  }
+}
+
+void sim_socket_poll(void) {
+  if (listen_fd == SIM_INVALID_FD)
+    return;
+  accept_client();
+  if (client_fd != SIM_INVALID_FD)
+    read_client();
+}
+
+static int write_all(const uint8_t *buf, size_t len) {
+  size_t sent = 0;
+  int waits = 0;
+  while (sent < len) {
+    int n = (int)send(
+        client_fd, (const char *)buf + sent, (int)(len - sent), SIM_SEND_FLAGS);
+    if (n < 0) {
+      if (sim_would_block() && waits++ < SIM_SOCKET_MAX_WRITE_WAITS) {
+        sim_sleep_short();
+        continue;
+      }
+      return -1;
+    }
+    sent += (size_t)n;
+  }
+  return 0;
+}
+
+sim_socket_status_t sim_socket_send(const uint8_t *data, size_t len) {
+  if (client_fd == SIM_INVALID_FD)
+    return SIM_SOCKET_ERR_NOT_CONNECTED;
+
+  uint8_t frame[SIM_SOCKET_FRAME_SIZE];
+  size_t offset = 0;
+  do {
+    size_t take = len - offset;
+    if (take > SIM_SOCKET_FRAME_SIZE)
+      take = SIM_SOCKET_FRAME_SIZE;
+    memset(frame, 0, sizeof(frame));
+    if (take > 0)
+      memcpy(frame, data + offset, take);
+    if (write_all(frame, sizeof(frame)) != 0) {
+      close_client();
+      return SIM_SOCKET_ERR_WRITE;
+    }
+    offset += take;
+  } while (offset < len);
+  return SIM_SOCKET_OK;
+}
+
+int sim_socket_is_connected(void) {
+  return client_fd != SIM_INVALID_FD;
+}
+
+uint16_t sim_socket_port(void) {
+  return bound_port;
+}
+
+void sim_socket_deinit(void) {
+  close_client();
+  close_listener();
+  bound_port = 0;
+}
diff --git a/simulator/transport/sim_socket.h b/simulator/transport/sim_socket.h
new file mode 100644
index 00000000..c85cea8f
--- /dev/null
+++ b/simulator/transport/sim_socket.h
@@ -0,0 +1,73 @@
+/**
+ * @file    sim_socket.h
+ * @brief   Non-blocking TCP server that carries USB-style frames between the
+ *          Cypherock SDK (hw-simulator package) and the X1 firmware simulator.
+ *
+ * The simulator runs a single-threaded main loop. This module never blocks:
+ * call sim_socket_poll() once per loop iteration and it will accept a client,
+ * read whatever bytes are available, rebuild fixed-size frames and hand each
+ * complete frame to the callback.
+ *
+ * Copy into: x1_wallet_firmware/simulator/transport/
+ */
+#ifndef SIM_SOCKET_H
+#define SIM_SOCKET_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Must match FRAME_SIZE in packages/hw-simulator/src/constants.ts. */
+#ifndef SIM_SOCKET_FRAME_SIZE
+#define SIM_SOCKET_FRAME_SIZE 64
+#endif
+
+/** Default TCP port; override with env CYPHEROCK_SIM_PORT at runtime. */
+#ifndef SIM_SOCKET_DEFAULT_PORT
+#define SIM_SOCKET_DEFAULT_PORT 52640
+#endif
+
+/** Called once per complete frame received from the SDK. */
+typedef void (*sim_socket_rx_cb_t)(const uint8_t *frame, size_t len);
+
+typedef enum {
+  SIM_SOCKET_OK = 0,
+  SIM_SOCKET_ERR_SOCKET = -1,
+  SIM_SOCKET_ERR_BIND = -2,
+  SIM_SOCKET_ERR_LISTEN = -3,
+  SIM_SOCKET_ERR_NOT_CONNECTED = -4,
+  SIM_SOCKET_ERR_WRITE = -5,
+} sim_socket_status_t;
+
+/**
+ * Start listening on 127.0.0.1:port. Pass port 0 to use
+ * CYPHEROCK_SIM_PORT or SIM_SOCKET_DEFAULT_PORT.
+ */
+sim_socket_status_t sim_socket_init(uint16_t port, sim_socket_rx_cb_t rx_cb);
+
+/** Accept/read without blocking. Call every main-loop iteration. */
+void sim_socket_poll(void);
+
+/**
+ * Send data to the connected SDK client, split into zero-padded frames of
+ * SIM_SOCKET_FRAME_SIZE bytes.
+ */
+sim_socket_status_t sim_socket_send(const uint8_t *data, size_t len);
+
+/** 1 if an SDK client is connected, else 0. */
+int sim_socket_is_connected(void);
+
+/** Port actually bound (useful when 0 was requested in tests). */
+uint16_t sim_socket_port(void);
+
+/** Close client and listener. */
+void sim_socket_deinit(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SIM_SOCKET_H */
diff --git a/simulator/transport/sim_transport.c b/simulator/transport/sim_transport.c
new file mode 100644
index 00000000..0fe12a2a
--- /dev/null
+++ b/simulator/transport/sim_transport.c
@@ -0,0 +1,76 @@
+/**
+ * @file    sim_transport.c
+ * @brief   Routes frames between the TCP bridge and the simulator USB device.
+ *
+ * sim_socket.c knows nothing about Cypherock; this file adds the runtime
+ * switches (loopback, trace) and hands every frame to the receive callback
+ * that simulator/USB/sim_usb.c registers.
+ */
+#include "sim_transport.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "sim_socket.h"
+
+static sim_transport_rx_cb_t firmware_rx = NULL;
+static int loopback = 0; /* CYPHEROCK_SIM_LOOPBACK=1 */
+static int trace = 0;    /* CYPHEROCK_SIM_VERBOSE=1 */
+static int in_tick = 0;
+
+static void dump(const char *dir, const uint8_t *buf, size_t len) {
+  if (!trace)
+    return;
+  fprintf(stderr, "[sim_transport] %s %2u:", dir, (unsigned)len);
+  for (size_t i = 0; i < len; i++)
+    fprintf(stderr, " %02x", buf[i]);
+  fputc('\n', stderr);
+  fflush(stderr);
+}
+
+static void on_frame(const uint8_t *frame, size_t len) {
+  dump("rx", frame, len);
+  if (loopback) {
+    sim_socket_send(frame, len);
+    return;
+  }
+  if (firmware_rx)
+    firmware_rx(frame, len);
+}
+
+int sim_transport_init(sim_transport_rx_cb_t rx_cb) {
+  const char *lb = getenv("CYPHEROCK_SIM_LOOPBACK");
+  const char *vb = getenv("CYPHEROCK_SIM_VERBOSE");
+  loopback = (lb && lb[0] == '1');
+  trace = (vb && vb[0] == '1');
+  firmware_rx = rx_cb;
+
+  if (sim_socket_init(0, on_frame) != SIM_SOCKET_OK) {
+    fprintf(stderr,
+            "[sim_transport] bridge not started (port busy?); running without "
+            "a host\n");
+    return -1;
+  }
+  if (loopback)
+    fprintf(stderr,
+            "[sim_transport] LOOPBACK: frames are echoed, firmware is not "
+            "called\n");
+  return 0;
+}
+
+void sim_transport_tick(void) {
+  if (in_tick) /* never re-enter while the parser is running */
+    return;
+  in_tick = 1;
+  sim_socket_poll();
+  in_tick = 0;
+}
+
+int sim_transport_write(const uint8_t *data, size_t len) {
+  dump("tx", data, len);
+  return sim_socket_send(data, len) == SIM_SOCKET_OK ? 0 : -1;
+}
+
+int sim_transport_is_connected(void) {
+  return sim_socket_is_connected();
+}
diff --git a/simulator/transport/sim_transport.h b/simulator/transport/sim_transport.h
new file mode 100644
index 00000000..bb565415
--- /dev/null
+++ b/simulator/transport/sim_transport.h
@@ -0,0 +1,45 @@
+/**
+ * @file    sim_transport.h
+ * @brief   Glue between the TCP frame server (sim_socket) and the simulator's
+ *          USB device (simulator/USB/sim_usb.c).
+ *
+ * Environment variables (read once at start-up):
+ *   CYPHEROCK_SIM_PORT=52640   TCP port on 127.0.0.1
+ *   CYPHEROCK_SIM_VERBOSE=1    hex trace of every frame on stderr
+ *   CYPHEROCK_SIM_LOOPBACK=1   echo frames back instead of calling firmware
+ */
+#ifndef SIM_TRANSPORT_H
+#define SIM_TRANSPORT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Called once for every 64-byte frame that arrives from the SDK. */
+typedef void (*sim_transport_rx_cb_t)(const uint8_t *frame, size_t len);
+
+/**
+ * Listen on 127.0.0.1:52640 (or $CYPHEROCK_SIM_PORT). Returns 0 on success.
+ * On failure it logs and returns -1; the simulator keeps running without a
+ * host, like a device with no USB cable.
+ */
+int sim_transport_init(sim_transport_rx_cb_t rx_cb);
+
+/** Non-blocking: accept, read and dispatch complete frames. Safe to call
+ * often; re-entrant calls are ignored. */
+void sim_transport_tick(void);
+
+/** Firmware to SDK. Zero-pads into 64-byte frames. Returns 0 on success. */
+int sim_transport_write(const uint8_t *data, size_t len);
+
+/** 1 if an SDK client is connected, else 0. */
+int sim_transport_is_connected(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SIM_TRANSPORT_H */
